# Maintainer: Your Name <your.email@example.com>
pkgname=sql-sanitizer-git
pkgver=r1.0.0
pkgrel=1
pkgdesc="Ultra-fast, zero-ORM, injection-safe text-to-SQLite stream filter in Bison/C (VCS master)"
arch=('x86_64' 'aarch64')
url="https://github.com/xsigil/SQL-sanitizer"
license=('MIT')
depends=('glibc')
makedepends=('git' 'bison' 'gcc')
checkdepends=('sqlite')
provides=('sql-sanitizer')
conflicts=('sql-sanitizer')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "SQL-sanitizer"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "SQL-sanitizer"
    make CFLAGS="$CFLAGS -std=c99"
}

check() {
    cd "SQL-sanitizer"
    make test
}

package() {
    cd "SQL-sanitizer"

    install -Dm755 bin/sql_filter "$pkgdir/usr/bin/sql_filter"

    if [ -f "doc/sql_filter.1" ]; then
        install -Dm644 doc/sql_filter.1 "$pkgdir/usr/share/man/man1/sql_filter.1"
    fi

    if [ -f "LICENSE" ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
